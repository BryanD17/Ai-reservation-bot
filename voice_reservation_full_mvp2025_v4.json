  "active": false,
  "createdAt": "2025-06-25T02:17:52.904217Z",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "parameters": {
        "httpMethod": "POST",
