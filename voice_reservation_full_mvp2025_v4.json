        "responseMode": "onReceived"
      },
      "id": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "name": "Download Recording",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "basicAuth",
        "genericAuthCredential": "Twilio HTTP (ENV)",
        "requestMethod": "GET",
        "url": "={{ $json.body.RecordingUrl }}.wav",
        "responseFormat": "file"
      },
      "id": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "name": "Transcribe Audio",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "credentials": {
        "OpenAI Api": {
          "id": "openai_env",
          "name": "OpenAI (ENV)"
        }
      },
      "parameters": {
        "resource": "audio",
        "operation": "transcribeRecording",
        "binaryProperty": "data",
        "model": "whisper-1",
        "responseFormat": "text"
      },
      "id": 3,
      "position": [
        680,
        300
      ]
    },
    {
      "name": "Extract info (GPT-4o)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "credentials": {
        "OpenAI Api": {
          "id": "openai_env",
          "name": "OpenAI (ENV)"
        }
      },
      "parameters": {
        "resource": "text",
        "operation": "messageModel",
        "model": "gpt-4o-mini",
        "messagesUi": {
          "messageValues": [
            {
              "role": "system",
              "content": "Suggest no follow\u2011ups. Extract customer_name, party_size (int), reservation_date (YYYY-MM-DD) and reservation_time (24h HH:MM). Respond ONLY JSON {\"name\":\"...\",\"party\":4,\"date\":\"YYYY-MM-DD\",\"time\":\"HH:MM\"}"
            },
            {
              "role": "user",
              "content": "{{ $json.text }}"
            }
          ]
        },
        "simplifyOutput": true,
        "outputContentAsJson": true
      },
      "id": 4,
      "position": [
        920,
        300
      ]
    },
    {
      "name": "Generate Code",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "parameters": {
        "functionCode": "items[0].json.code=(Math.floor(Math.random()*9000)+1000).toString(); return items;"
      },
      "id": 5,
      "position": [
        1160,
        300
      ]
    },
    {
      "name": "Check OpenTable",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.opentable.com/check",
        "jsonParameters": true,
        "bodyParametersJson": "={\"date\": $json.date, \"time\": $json.time, \"party\": $json.party}"
      },
      "id": 6,
      "position": [
        1400,
        300
      ]
    },
    {
      "name": "If Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.available }}"
            }
          ]
        }
      },
      "id": 7,
      "position": [
        1640,
        300
      ]
    },
    {
      "name": "Insert Supabase",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 1,
      "credentials": {
        "postgres": {
          "id": "supabase_env",
          "name": "Supabase (ENV)"
        }
      },
      "parameters": {
        "table": "reservations",
        "columns": "name,party,date,time,code",
        "values": "={{$json.name}},={{$json.party}},={{$json.date}},={{$json.time}},={{$json.code}}"
      },
      "id": 8,
      "position": [
        1880,
        300
      ]
    },
    {
      "name": "Suggest Time",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1,
      "credentials": {
        "OpenAI Api": {
          "id": "openai_env",
          "name": "OpenAI (ENV)"
        }
      },
      "parameters": {
        "resource": "text",
        "operation": "messageModel",
        "model": "gpt-4o-mini",
        "messagesUi": {
          "messageValues": [
            {
              "role": "system",
              "content": "Suggest the nearest available reservation time 30\u201190 minutes from the requested slot. Respond ONLY JSON {\"suggested_time\":\"HH:MM\"}"
            },
            {
              "role": "user",
              "content": "{{`Date: ${$json.date}, Time: ${$json.time}, Party: ${$json.party}`}}"
            }
          ]
        },
        "simplifyOutput": true,
        "outputContentAsJson": true
      },
      "id": 9,
      "position": [
        2120,
        420
      ]
    },
    {
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "credentials": {
        "twilioApi": {
          "id": "twilio_env",
          "name": "Twilio (ENV)"
        }
      },
      "parameters": {
        "from": "={{$env.TWILIO_PHONE_NUMBER}}",
        "to": "={{ $json.body.From }}",
        "message": "={{ $json.code ? `Your reservation for ${$json.date} at ${$json.time} is confirmed. Code: ${$json.code}` : `The requested slot is full. We can offer ${$json.suggested_time}. Reply YES to confirm.` }}"
      },
      "id": 10,
      "position": [
        2360,
        300
      ]
    },
    {
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "parameters": {
        "responseCode": 200,
        "responseData": "=<Response><Hangup/></Response>",
        "responseHeadersUi": {
          "parameter": [
            {
              "name": "Content-Type",
              "value": "text/xml"
            }
          ]
        }
      },
      "id": 11,
      "position": [
        2600,
        300
      ]
    }
  ],
